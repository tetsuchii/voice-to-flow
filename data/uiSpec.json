{
  "start": "widget",
  "pages": [
    {
      "id": "widget",
      "ui": {
        "type": "blank",
        "title": "Enlight Widget in Banking App",
        "layout": "single-column"
      }
    },
    {
      "id": "onboarding_learn",
      "ui": {
        "type": "blank",
        "title": "Onboarding - Learn",
        "layout": "single-column"
      }
    },
    {
      "id": "onboarding_earn",
      "ui": {
        "type": "blank",
        "title": "Onboarding - Earn",
        "layout": "single-column"
      }
    },
    {
      "id": "onboarding_redeem",
      "ui": {
        "type": "blank",
        "title": "Onboarding - Redeem",
        "layout": "single-column"
      }
    },
    {
      "id": "sso_link",
      "ui": {
        "type": "blank",
        "title": "Link User Profile via SSO",
        "layout": "single-column"
      }
    },
    {
      "id": "dashboard",
      "ui": {
        "type": "blank",
        "title": "Enlight Dashboard",
        "layout": "single-column"
      }
    },
    {
      "id": "activity_choice",
      "ui": {
        "type": "message",
        "title": "Processing",
        "text": "Processing your request...",
        "severity": "info",
        "layout": "centered"
      }
    },
    {
      "id": "mission_list",
      "ui": {
        "type": "blank",
        "title": "Mission List Screen",
        "layout": "single-column"
      }
    },
    {
      "id": "mission_detail",
      "ui": {
        "type": "detail",
        "title": "Mission Detail Screen",
        "layout": "single-column",
        "components": [
          {
            "kind": "card",
            "title": "Information",
            "content": "Detailed information will be displayed here."
          }
        ]
      }
    },
    {
      "id": "mission_progress",
      "ui": {
        "type": "blank",
        "title": "Mission Progress Screen",
        "layout": "single-column"
      }
    },
    {
      "id": "mission_completion",
      "ui": {
        "type": "blank",
        "title": "Mission Completion Screen",
        "layout": "single-column"
      }
    },
    {
      "id": "quiz_selection",
      "ui": {
        "type": "blank",
        "title": "Quiz Selection Screen",
        "layout": "single-column"
      }
    },
    {
      "id": "quiz_intro",
      "ui": {
        "type": "blank",
        "title": "Quiz Intro Screen",
        "layout": "single-column"
      }
    },
    {
      "id": "quiz_question",
      "ui": {
        "type": "blank",
        "title": "Question Screen",
        "layout": "single-column"
      }
    },
    {
      "id": "quiz_completion",
      "ui": {
        "type": "blank",
        "title": "Quiz Completion Screen",
        "layout": "single-column"
      }
    },
    {
      "id": "rewards_catalog",
      "ui": {
        "type": "blank",
        "title": "Rewards Catalog",
        "layout": "single-column"
      }
    }
  ],
  "routes": [
    {
      "from": "widget",
      "to": "onboarding_learn",
      "when": "widget tapped"
    },
    {
      "from": "onboarding_learn",
      "to": "onboarding_earn",
      "when": "next"
    },
    {
      "from": "onboarding_earn",
      "to": "onboarding_redeem",
      "when": "next"
    },
    {
      "from": "onboarding_redeem",
      "to": "sso_link",
      "when": "get started"
    },
    {
      "from": "sso_link",
      "to": "dashboard",
      "when": "profile linked"
    },
    {
      "from": "dashboard",
      "to": "activity_choice",
      "when": "user selects activity"
    },
    {
      "from": "activity_choice",
      "to": "mission_list",
      "when": "missions selected"
    },
    {
      "from": "activity_choice",
      "to": "quiz_selection",
      "when": "quizzes selected"
    }
  ]
}