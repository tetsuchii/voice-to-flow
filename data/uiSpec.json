{
  "start": "home",
  "pages": [
    {
      "id": "home",
      "ui": {
        "type": "search",
        "title": "Home",
        "layout": "centered",
        "fields": [
          {
            "name": "searchQuery",
            "label": "Search",
            "type": "text",
            "placeholder": "Enter search term..."
          }
        ],
        "actions": [
          {
            "id": "searchBtn",
            "label": "Search",
            "variant": "contained",
            "color": "primary",
            "action": "submit"
          }
        ]
      }
    },
    {
      "id": "onboarding",
      "ui": {
        "type": "message",
        "title": "Processing",
        "text": "Processing your request...",
        "severity": "info",
        "layout": "centered"
      }
    },
    {
      "id": "get-recipe",
      "ui": {
        "type": "blank",
        "title": "Recipe Suggestion",
        "layout": "single-column"
      }
    },
    {
      "id": "ingredient-inventory",
      "ui": {
        "type": "blank",
        "title": "Ingredient Inventory",
        "layout": "single-column"
      }
    },
    {
      "id": "meal-planner",
      "ui": {
        "type": "blank",
        "title": "Meal Planner Calendar",
        "layout": "single-column"
      }
    },
    {
      "id": "shopping-list",
      "ui": {
        "type": "blank",
        "title": "Shopping List",
        "layout": "single-column"
      }
    },
    {
      "id": "saved-recipes",
      "ui": {
        "type": "blank",
        "title": "Saved Recipes",
        "layout": "single-column"
      }
    },
    {
      "id": "recipe-details",
      "ui": {
        "type": "detail",
        "title": "Recipe Details",
        "layout": "single-column",
        "components": [
          {
            "kind": "card",
            "title": "Information",
            "content": "Detailed information will be displayed here."
          }
        ]
      }
    },
    {
      "id": "profile",
      "ui": {
        "type": "blank",
        "title": "User Profile",
        "layout": "single-column"
      }
    },
    {
      "id": "reminder-action",
      "ui": {
        "type": "blank",
        "title": "Ingredient Reminder",
        "layout": "single-column"
      }
    },
    {
      "id": "social-sharing",
      "ui": {
        "type": "blank",
        "title": "Social Sharing",
        "layout": "single-column"
      }
    }
  ],
  "routes": [
    {
      "from": "home",
      "to": "onboarding",
      "when": "First time user or settings reset"
    },
    {
      "from": "home",
      "to": "get-recipe"
    },
    {
      "from": "home",
      "to": "meal-planner"
    },
    {
      "from": "home",
      "to": "ingredient-inventory"
    },
    {
      "from": "home",
      "to": "saved-recipes"
    },
    {
      "from": "home",
      "to": "profile"
    },
    {
      "from": "onboarding",
      "to": "get-recipe"
    },
    {
      "from": "onboarding",
      "to": "meal-planner"
    },
    {
      "from": "get-recipe",
      "to": "recipe-details",
      "when": "User selects a recipe"
    },
    {
      "from": "get-recipe",
      "to": "saved-recipes",
      "when": "User saves/favorites a recipe"
    },
    {
      "from": "get-recipe",
      "to": "ingredient-inventory",
      "when": "User wants to add another ingredient"
    },
    {
      "from": "recipe-details",
      "to": "meal-planner",
      "when": "User adds recipe to calendar"
    },
    {
      "from": "recipe-details",
      "to": "saved-recipes",
      "when": "User saves/favorites recipe"
    },
    {
      "from": "meal-planner",
      "to": "shopping-list"
    },
    {
      "from": "meal-planner",
      "to": "reminder-action"
    },
    {
      "from": "shopping-list",
      "to": "ingredient-inventory",
      "when": "User updates inventory after shopping"
    },
    {
      "from": "recipe-details",
      "to": "ingredient-inventory",
      "when": "Recipe cooked—deduct ingredients"
    },
    {
      "from": "profile",
      "to": "onboarding",
      "when": "User edits cooking preferences or equipment"
    },
    {
      "from": "saved-recipes",
      "to": "recipe-details",
      "when": "User opens saved recipe"
    },
    {
      "from": "recipe-details",
      "to": "social-sharing",
      "when": "User shares recipe"
    }
  ]
}