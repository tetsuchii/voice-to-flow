{
  "start": "home",
  "pages": [
    {
      "id": "home",
      "ui": {
        "type": "search",
        "title": "Főoldal",
        "layout": "centered",
        "fields": [
          {
            "name": "searchQuery",
            "label": "Search",
            "type": "text",
            "placeholder": "Enter search term..."
          }
        ],
        "actions": [
          {
            "id": "searchBtn",
            "label": "Search",
            "variant": "contained",
            "color": "primary",
            "action": "submit"
          }
        ]
      }
    },
    {
      "id": "search_order",
      "ui": {
        "type": "blank",
        "title": "Rendelés keresése",
        "layout": "single-column"
      }
    },
    {
      "id": "order_found",
      "ui": {
        "type": "message",
        "title": "Processing",
        "text": "Processing your request...",
        "severity": "info",
        "layout": "centered"
      }
    },
    {
      "id": "order_status",
      "ui": {
        "type": "detail",
        "title": "Rendelés állapota",
        "layout": "single-column",
        "components": [
          {
            "kind": "card",
            "title": "Information",
            "content": "Detailed information will be displayed here."
          }
        ]
      }
    },
    {
      "id": "error_page",
      "ui": {
        "type": "blank",
        "title": "Hiba oldal",
        "layout": "single-column"
      }
    },
    {
      "id": "admin_upload",
      "ui": {
        "type": "blank",
        "title": "Admin Excel feltöltés",
        "layout": "single-column"
      }
    }
  ],
  "routes": [
    {
      "from": "home",
      "to": "search_order",
      "when": "rendelési szám beírása és keresés gomb"
    },
    {
      "from": "search_order",
      "to": "order_found"
    },
    {
      "from": "order_found",
      "to": "order_status",
      "when": "rendelés megtalálva"
    },
    {
      "from": "order_found",
      "to": "error_page",
      "when": "rendelés nem található"
    },
    {
      "from": "error_page",
      "to": "home",
      "when": "vissza gomb"
    },
    {
      "from": "order_status",
      "to": "home",
      "when": "új keresés gomb"
    }
  ]
}